# MarsWallex 测试环境模拟卡交易配置
# 复制为 config.env 后填写。config.env 含密钥，不要提交到代码仓库或发给他人。
# 也可以用环境变量覆盖：MARSWALLEX_BASE_URL、MARSWALLEX_DEVELOPER_ID、MARSWALLEX_API_TOKEN、MARSWALLEX_PRIVATE_KEY_FILE、MARSWALLEX_PRIVATE_KEY

# 测试环境 OpenAPI 地址（含 /portal/api），只允许 feibeiglobal-test.com 域名
BASE_URL=https://api.feibeiglobal-test.com/portal/api

# 开放平台 → 开发者信息中的 developer_id 与 api_token
DEVELOPER_ID=<developer_id>
API_TOKEN=<api_token>

# 商户 RSA 私钥（与在开放平台登记的公钥配对），二选一：
# 1. PEM 文件路径，支持 PKCS#8（BEGIN PRIVATE KEY）和 PKCS#1（BEGIN RSA PRIVATE KEY）；相对路径相对本文件所在目录
PRIVATE_KEY_FILE=./merchant_private.pem
# 2. 不带头尾的 base64 私钥字符串
# PRIVATE_KEY=

# 请求超时（秒）
TIMEOUT_SECONDS=30
